            "state": "translated",
            "value": "Un vote par appareil et par tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto per dispositivo e turno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One vote per device per round."
          }
        },
        "es": {
