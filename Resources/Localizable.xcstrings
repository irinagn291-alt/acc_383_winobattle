    "Single elimination. Byes advance automatically; tied matches require penalties.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single elimination. Byes advance automatically; tied matches require penalties."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminação simples. Folgas avançam automaticamente; empates exigem pênaltis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminación directa. Los exentos avanzan; los empates requieren penaltis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "K.-o.-System. Freilose rücken vor; bei Gleichstand entscheiden Elfmeter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élimination directe. Les exempts avancent ; les égalités se règlent aux tirs au but."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminazione diretta. I riposi passano; i pareggi richiedono rigori."
          }
        }
      }
    },
    "Each team meets every other team once. A win earns 3 points; a draw earns 1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each team meets every other team once. A win earns 3 points; a draw earns 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada time enfrenta todos uma vez. Vitória vale 3 pontos; empate, 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada equipo juega contra todos una vez. Victoria: 3 puntos; empate: 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Team spielt einmal gegen jedes andere. Sieg: 3 Punkte, Unentschieden: 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque équipe rencontre toutes les autres une fois. Victoire : 3 points, nul : 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni squadra incontra le altre una volta. Vittoria: 3 punti, pareggio: 1."
          }
        }
      }
    },
    "2–32 unique teams, one per line. First-listed teams receive any byes. Team order fixes the draw.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2–32 unique teams, one per line. First-listed teams receive any byes. Team order fixes the draw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 a 32 times únicos, um por linha. Os primeiros recebem folgas. A ordem define os confrontos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 a 32 equipos únicos, uno por línea. Los primeros quedan exentos. El orden fija los cruces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2–32 eindeutige Teams, eines pro Zeile. Die ersten erhalten Freilose. Die Reihenfolge legt Paarungen fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 à 32 équipes distinctes, une par ligne. Les premières sont exemptées. L’ordre fixe les rencontres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 2 a 32 squadre uniche, una per riga. Le prime ricevono i riposi. L’ordine fissa gli incontri."
          }
        }
      }
    },
    "Matches in the same round start 90 minutes apart. Kickoff times can be edited in each report.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches in the same round start 90 minutes apart. Kickoff times can be edited in each report."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos da mesma rodada começam a cada 90 minutos. Altere os horários nas súmulas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los partidos de la jornada empiezan cada 90 minutos. Edita los horarios en cada acta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele einer Runde beginnen im Abstand von 90 Minuten. Zeiten lassen sich im Bericht ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les matchs d’une journée démarrent à 90 minutes d’intervalle. Modifiez l’heure dans le rapport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partite del turno iniziano a intervalli di 90 minuti. Modifica gli orari nel referto."
          }
        }
      }
    },
    "A profile is optional. All tournament tools work offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile is optional. All tournament tools work offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil é opcional. Todas as ferramentas funcionam offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil es opcional. Todas las herramientas funcionan sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil ist freiwillig. Alle Turnierwerkzeuge funktionieren offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil est facultatif. Tous les outils fonctionnent hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo è facoltativo. Tutti gli strumenti funzionano offline."
          }
        }
      }
    },
    "A reminder one day before each round and a report reminder two hours after kickoff. Changes are checked when the app opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder one day before each round and a report reminder two hours after kickoff. Changes are checked when the app opens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete um dia antes da rodada e outro para a súmula duas horas após o início. Alterações são verificadas ao abrir o app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso un día antes de la jornada y otro para el acta dos horas después del inicio. Se revisan los cambios al abrir la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung einen Tag vor der Runde und für Berichte zwei Stunden nach Anstoß. Änderungen werden beim Öffnen geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel la veille de la journée et un autre pour le rapport deux heures après le début. Changements vérifiés à l’ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria un giorno prima del turno e per il referto due ore dopo l’inizio. Modifiche verificate all’apertura."
          }
        }
      }
    },
    "A tied knockout match needs a penalty winner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tied knockout match needs a penalty winner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um empate nas eliminatórias precisa de vencedor nos pênaltis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un empate eliminatorio necesita un ganador por penaltis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein K.-o.-Unentschieden braucht einen Sieger im Elfmeterschießen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une égalité en élimination directe exige un vainqueur aux tirs au but."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pareggio a eliminazione diretta richiede un vincitore ai rigori."
          }
        }
      }
    },
    "Add player rosters before opening the vote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add player rosters before opening the vote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os elencos antes de abrir a votação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las plantillas antes de abrir la votación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Abstimmung Spielerkader hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les effectifs avant le vote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le rose prima di aprire il voto."
          }
        }
      }
    },
    "Add players in Teams and player rosters to record goalscorers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add players in Teams and player rosters to record goalscorers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione jogadores em Times e elencos para registrar os artilheiros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade jugadores en Equipos y plantillas para registrar goleadores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unter Teams und Spielerkader Spieler hinzu, um Torschützen zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les joueurs dans Équipes et effectifs pour noter les buteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi giocatori in Squadre e rose per registrare i marcatori."
          }
        }
      }
    },
    "Apple sign-in is unavailable. Continue with your local profile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Continue with your local profile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Continue com o perfil local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Nutze dein lokales Profil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva."
          }
        }
      }
    },
    "Changing a winner clears results in later dependent matches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing a winner clears results in later dependent matches."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar um vencedor apaga resultados dos jogos seguintes dependentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar un ganador borra los resultados posteriores dependientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Sieger löscht Ergebnisse abhängiger Folgespiele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer un vainqueur efface les résultats des matchs suivants qui en dépendent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare vincitore cancella i risultati delle partite successive dipendenti."
          }
        }
      }
    },
    "Check the score, penalties and scorers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the score, penalties and scorers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o placar, os pênaltis e os artilheiros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el marcador, los penaltis y los goleadores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnis, Elfmeter und Torschützen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le score, les tirs au but et les buteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla risultato, rigori e marcatori."
          }
        }
      }
    },
    "Dependent results may be cleared if the winner changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependent results may be cleared if the winner changes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados dependentes podem ser apagados se o vencedor mudar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados dependientes pueden borrarse si cambia el ganador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängige Ergebnisse können bei einem anderen Sieger gelöscht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats dépendants peuvent être effacés si le vainqueur change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati dipendenti possono essere cancellati se cambia il vincitore."
          }
        }
      }
    },
    "Fixtures, local standings and the next round, available offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixtures, local standings and the next round, available offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos, classificação local e próxima rodada disponíveis offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partidos, clasificación local y próxima jornada sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielplan, lokale Tabelle und nächste Runde, auch offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencontres, classement local et prochaine journée, hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Partite, classifica locale e prossimo turno, offline."
          }
        }
      }
    },
    "Invitation-only. Shared edits are checked when the app opens or you sync. Offline changes are kept on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation-only. Shared edits are checked when the app opens or you sync. Offline changes are kept on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente por convite. Alterações são verificadas ao abrir ou sincronizar. Mudanças offline ficam neste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo por invitación. Los cambios se revisan al abrir o sincronizar. Los cambios sin conexión quedan aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf Einladung. Änderungen werden beim Öffnen oder Synchronisieren geprüft. Offline-Änderungen bleiben auf dem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur invitation. Modifications vérifiées à l’ouverture ou à la synchronisation. Les changements hors ligne restent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su invito. Modifiche verificate all’apertura o alla sincronizzazione. Quelle offline restano sul dispositivo."
          }
        }
      }
    },
    "Invitation-only sharing uses your iCloud account and storage. Editors submit reports for the owner to approve. Viewers cannot edit or vote. No public feed or chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Editors submit reports for the owner to approve. Viewers cannot edit or vote. No public feed or chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Editores enviam súmulas para aprovação do dono. Leitores não editam nem votam. Sem feed público ou chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Los editores envían actas al propietario. Los lectores no editan ni votan. Sin canal público ni chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Bearbeiter reichen Berichte zur Freigabe ein. Leser können weder bearbeiten noch abstimmen. Kein öffentlicher Feed oder Chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Les éditeurs soumettent des rapports au propriétaire. Les lecteurs ne modifient ni ne votent. Aucun fil public ni chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Gli editor inviano referti al proprietario. I lettori non modificano né votano. Nessun feed pubblico o chat."
          }
        }
      }
    },
    "One vote per profile per round. Offline votes identify this device; iCloud votes identify your iCloud profile. This is a community poll, with no prizes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One vote per profile per round. Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. This is a community poll, with no prizes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um voto por perfil por rodada. Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. É uma votação comunitária, sem prêmios."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto por perfil y jornada. Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Consulta comunitaria sin premios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stimme je Profil und Runde. Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Gemeinschaftsumfrage ohne Preise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vote par profil et journée. Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Sondage sans prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto per profilo e turno. Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Sondaggio senza premi."
          }
        }
      }
    },
    "Voting opens after every match in this round is complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voting opens after every match in this round is complete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A votação abre após o fim de todos os jogos da rodada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La votación abre cuando terminan todos los partidos de la jornada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abstimmung öffnet nach Abschluss aller Rundenspiele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vote ouvre après tous les matchs de la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voto si apre dopo tutte le partite del turno."
          }
        }
      }
    },
    "Your vote is saved. You may change it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vote is saved. You may change it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu voto foi salvo. Você pode alterá-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voto está guardado. Puedes cambiarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme ist gespeichert und kann geändert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vote est enregistré. Vous pouvez le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voto salvato. Puoi cambiarlo."
          }
        }
      }
    },
    "Your report will wait for the tournament owner’s approval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report will wait for the tournament owner’s approval."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua súmula aguardará a aprovação do dono do torneio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acta esperará la aprobación del propietario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bericht wartet auf die Freigabe des Eigentümers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rapport attendra l’approbation du propriétaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il referto attenderà l’approvazione del proprietario."
          }
        }
      }
    },
    "Scorers are optional. Recorded goals cannot exceed the team score.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorers are optional. Recorded goals cannot exceed the team score."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Artilheiros são opcionais. Os gols registrados não podem superar o placar do time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los goleadores son opcionales. Sus goles no pueden superar el marcador del equipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torschützen sind optional. Ihre Tore dürfen das Teamergebnis nicht überschreiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les buteurs sont facultatifs. Leurs buts ne peuvent dépasser le score de l’équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I marcatori sono facoltativi. I gol non possono superare il risultato della squadra."
          }
        }
      }
    },
    "Record player goals in match reports to see the scoring chart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record player goals in match reports to see the scoring chart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre gols nas súmulas para ver a artilharia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra goles en las actas para ver la lista de goleadores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Spielertore in Berichten für die Torschützenliste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez les buts dans les rapports pour voir les buteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i gol nei referti per la classifica marcatori."
          }
        }
      }
    },
    "Up to 30 players per team. The owner maintains rosters; names already used in reports stay in the record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 30 players per team. The owner maintains rosters; names already used in reports stay in the record."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 30 jogadores por time. O dono mantém os elencos; nomes usados nas súmulas ficam no registro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 30 jugadores por equipo. El propietario mantiene plantillas; los nombres usados en actas se conservan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 30 Spieler je Team. Der Eigentümer pflegt Kader; Namen aus Berichten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 30 joueurs par équipe. Le propriétaire gère les effectifs ; les noms des rapports sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 30 giocatori per squadra. Il proprietario gestisce le rose; i nomi nei referti restano registrati."
          }
        }
      }
    },
    "Swipe across the bracket. Results advance winners automatically. Changing an earlier winner clears dependent results.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe across the bracket. Results advance winners automatically. Changing an earlier winner clears dependent results."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize pelas chaves. Os vencedores avançam automaticamente. Alterar um vencedor anterior apaga os resultados dependentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza por el cuadro. Los ganadores avanzan automáticamente. Cambiar un ganador anterior borra resultados dependientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische durch den Turnierbaum. Sieger rücken automatisch vor. Ein anderer früherer Sieger löscht abhängige Ergebnisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler le tableau. Les vainqueurs avancent automatiquement. Changer un ancien vainqueur efface les résultats dépendants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri il tabellone. I vincitori avanzano automaticamente. Cambiare un vincitore precedente cancella risultati dipendenti."
          }
        }
      }
    },
    "3 points for a win, 1 for a draw. Ties: goal difference, then goals scored. Exact ties share the championship. Penalties do not count as goals in the table. Knockout tables are statistical summaries; the final decides the champion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 points for a win, 1 for a draw. Ties: goal difference, then goals scored. Exact ties share the championship. Penalties do not count as goals in the table. Knockout tables are statistical summaries; the final decides the champion."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitória: 3 pontos; empate: 1. Desempate por saldo e gols marcados. Empate exato divide o título. Pênaltis não contam como gols. Nas eliminatórias, a tabela resume estatísticas; a final decide o campeão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Victoria: 3 puntos; empate: 1. Desempate por diferencia y goles a favor. Igualdad exacta comparte título. Los penaltis no suman goles. En eliminación directa la tabla es estadística; decide la final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieg: 3 Punkte, Remis: 1. Danach Tordifferenz und erzielte Tore. Exakter Gleichstand teilt den Titel. Elfmeter zählen nicht als Tore. Die K.-o.-Tabelle ist Statistik; das Finale entscheidet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Victoire : 3 points, nul : 1. Égalités départagées par différence puis buts marqués. Égalité exacte : titre partagé. Tirs au but exclus. En élimination, le tableau est statistique ; la finale décide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vittoria: 3 punti, pareggio: 1. Poi differenza reti e gol fatti. Parità esatta: titolo condiviso. Rigori esclusi dai gol. A eliminazione la classifica è statistica; decide la finale."
          }
        }
      }
    },
    "Cloud collaboration needs a signed build with iCloud enabled. Offline tools work here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Offline tools work here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. As ferramentas offline funcionam aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Aquí funcionan las herramientas sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Offline-Werkzeuge funktionieren hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Les outils hors ligne fonctionnent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Gli strumenti offline funzionano qui."
          }
        }
      }
    },
    "Sign in to iCloud in device Settings to collaborate. Offline tournaments need no account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Offline tournaments need no account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Torneios offline não precisam de conta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Los torneos sin conexión no necesitan cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Offline-Turniere brauchen kein Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Les tournois hors ligne n’exigent aucun compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. I tornei offline non richiedono account."
          }
        }
      }
    },
    "The shared tournament could not be read. Ask the owner to check the invitation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared tournament could not be read. Ask the owner to check the invitation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o torneio. Peça ao dono para conferir o convite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el torneo. Pide al propietario que revise la invitación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Turnier ist nicht lesbar. Bitte den Eigentümer, die Einladung zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture du tournoi impossible. Demandez au propriétaire de vérifier l’invitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il torneo. Chiedi al proprietario di controllare l’invito."
          }
        }
      }
    },
    "This tournament is too large to sync. Local data is safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tournament is too large to sync. Local data is safe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este torneio é grande demais para sincronizar. Os dados locais estão seguros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El torneo es demasiado grande para sincronizar. Los datos locales están seguros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Turnier ist zu groß zur Synchronisierung. Lokale Daten sind sicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tournoi est trop volumineux à synchroniser. Les données locales sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torneo troppo grande per la sincronizzazione. I dati locali sono al sicuro."
          }
        }
      }
    },
    "iCloud could not update. Local changes are safe. Check your connection and iCloud access, then retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Local changes are safe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. As alterações locais estão seguras. Confira a conexão e o acesso e tente novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Los cambios locales están seguros. Revisa conexión y acceso y reintenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Lokale Änderungen sind sicher. Verbindung und Zugriff prüfen, dann erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Modifications locales conservées. Vérifiez connexion et accès, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Modifiche locali al sicuro. Controlla connessione e accesso, poi riprova."
          }
        }
      }
    },
    "iCloud storage is full. Local changes are safe; free space and sync again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Local changes are safe; free space and sync again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Alterações locais seguras; libere espaço e sincronize de novo."
          }
