            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio."
          }
        }
      }
    },
    "One vote per device per round.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stimme pro Gerät und Runde."
          }
        },
        "fr": {
